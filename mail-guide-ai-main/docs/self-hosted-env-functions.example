# ============================================================
# 复制本文件为 supabase-selfhost/.env.functions（与 docker-compose 中 functions.env_file 一致）
# 勿提交真实密钥。官方说明：https://supabase.com/docs/guides/self-hosting/self-hosted-functions
# ============================================================

# --- Dify（与云端 npx supabase functions secrets set 对应）---
# DIFY_ANALYZE_*：必须对应 Dify 应用「独立站智能客服-邮件智能分析」→ API 访问 → Workflow 密钥（app-xxxx），切勿填成草稿应用的 Key
# DIFY_GATEWAY_API_KEY：应用层自拟强随机密钥（非 Dify app-xxxx）；生成：Windows PowerShell 或 CentOS/Linux `openssl rand -base64 32`（见仓库根 docs/docker-deploy-new-server.md §四 步骤 5b）；验收见同文档 §六。
DIFY_GATEWAY_API_KEY=
# 供 Dify 草稿工作流 HTTP 节点回调自建 Supabase Edge 网关。
# Windows Docker 下通常用 host.docker.internal；生产请改为可被 Dify API 容器访问的 HTTPS/Kong 地址。
DIFY_GATEWAY_URL=http://host.docker.internal:8000/functions/v1/dify-gateway
DIFY_ANALYZE_URL=
DIFY_ANALYZE_KEY=
# DIFY_DRAFT_*：对应「独立站智能客服-邮件草稿生成」等工作流的密钥，与 ANALYZE 不可混用
DIFY_DRAFT_URL=
DIFY_DRAFT_KEY=

# generate-draft 等若仍引用 Lovable 网关
LOVABLE_API_KEY=

# sync-mailbox：若 cron 使用独立 key（可选，见 functions 源码）
# CRON_SERVICE_ROLE_KEY=

# sync-mailbox：完整 RFC822 体积上限（字节）。含附件邮件常 >500KB，过小会导致从不拉 MIME、附件无法入库。
# MAIL_SYNC_FULL_BODY_MAX_BYTES=5000000
# MAIL_SYNC_FULL_BODY_WITH_ATTACH_MAX_BYTES=25000000
# 增量同步：自动(cron)与手动(工作台)分流。未设 _AUTO/_INTERACTIVE 时可用 MAIL_SYNC_INCREMENTAL_INLINE_MAX_BYTES 同时覆盖两者。
# MAIL_SYNC_INCREMENTAL_INLINE_MAX_BYTES_AUTO=1500000
# MAIL_SYNC_INCREMENTAL_INLINE_MAX_BYTES_INTERACTIVE=5000000
# MAIL_SYNC_PER_ROUND_AUTO=1
# MAIL_SYNC_PER_ROUND_INTERACTIVE=5
# 按日补同步日期边界时区（分钟，默认 480 = UTC+8）
# MAIL_SYNC_DATE_TZ_OFFSET_MINUTES=480
# 按日补同步 IMAP 扩窗小时数（0=仅当天内部日期，约 160 UID；12=前后各 12h 兜底漏网）
# MAIL_SYNC_DATE_SEARCH_WIDEN_HOURS=12
# 按日补同步每批 UID 数（PER_ROUND × MAX_ROUNDS，默认 5×1=5）
# MAIL_SYNC_DATE_PER_ROUND=5
# MAIL_SYNC_DATE_MAX_ROUNDS=1
# 发件人 IMAP FROM 无命中时，按头 From 扫 UID
# MAIL_SYNC_DATE_FROM_SCAN_PER_ROUND=5
# MAIL_SYNC_DATE_FROM_SCAN_MAX_ROUNDS=1
# MAIL_SYNC_MAX_ROUNDS_AUTO=2
# MAIL_SYNC_MAX_ROUNDS_INTERACTIVE=2

# 邮箱 IMAP/SMTP TLS：遇到 UnknownIssuer 时配置邮箱 CA 证书链。
# 自建 Edge Runtime 的 User Worker 可能读不到挂载证书文件，代码已内置 163/TecSign 证书链兜底；
# 其他邮箱或后续证书轮换时，仍建议把 PEM 放到 supabase/functions/certs/mail-ca.pem 并同步到自建环境。
# MAIL_TLS_CA_CERT_PATH=/home/deno/functions/certs/mail-ca.pem
# MAIL_TLS_CA_CERT_PEM=
# Gmail/Outlook：须同步 functions/certs/public-ca.pem（Edge 沙箱读不了 /etc/ssl）
MAIL_PUBLIC_CA_CERT_PATH=/home/deno/functions/certs/public-ca.pem
# MAIL_LOCAL_TEST_MODE=false

# get-email-context 等
# API_KEY=

# 调度批大小（可选）
# DRAFT_SCHEDULE_BATCH=50
# COMPENSATING_ALERT_BATCH=40

# 运维告警邮件（可选，有代码内默认值）
# ALERT_SENDER_ADDRESS=
# ALERT_EMAIL_TO=

# --- ERP（Edge 单出口：Token + OMS 查单 + Java 网关拦截；勿提交 Git）---
# 详见 docs/erp-order-api.md、docs/erp-api-requirements.md §0
# ERP_TOKEN_URL=https://loginserver.bestwo.net:9443/connect/token
# ERP_OMS_BASE=https://omsapi.bestwo.net:9443
# ERP_GATEWAY_BASE=https://gatewayjava.bestwo.net:9443
# ERP_USERNAME=
# ERP_PASSWORD=
# ERP_CLIENT_ID=ERP

# --- ERP 拦截客户通知（erp-notify-customer，勿提交 Git）---
# 生成：openssl rand -base64 32
# ERP_NOTIFY_API_KEY=
# 测试联调用 pw 时：ERP_TOKEN_PASSWORD_FIELD=pw
# ERP_TOKEN_PASSWORD_FIELD=password

# --- 邮件同步稳定性（sync-mailbox / 后台 worker，可选）---
# MAIL_SYNC_DAYS_BACK=30
# MAIL_SYNC_PER_ROUND=5
# MAIL_SYNC_MAX_ROUNDS=2
# MAIL_SYNC_TIME_BUDGET_MS=40000
# MAIL_SYNC_FULL_BODY_MAX_BYTES=8000000
# MAIL_SYNC_FULL_BODY_WITH_ATTACH_MAX_BYTES=40000000
# MAIL_SYNC_BATCH_ATTACHMENT_FETCH_MAX_BYTES=42000000
# MAIL_SYNC_ATTACHMENT_PART_MAX_BYTES=30000000
# MAIL_SYNC_INCREMENTAL_INLINE_MAX_BYTES_AUTO=1500000
# MAIL_SYNC_PER_ROUND_AUTO=2
# MAIL_SYNC_MAX_ROUNDS_AUTO=2
# MAIL_SYNC_TIME_BUDGET_MS_AUTO=50000
# 推荐第一档（观察 1～2 天后可升到 5×3）：
# MAIL_SYNC_PER_ROUND_AUTO=3
# MAIL_SYNC_MAX_ROUNDS_AUTO=3
# MAIL_SYNC_TIME_BUDGET_MS_AUTO=50000
# 稳定后第二档：
# MAIL_SYNC_PER_ROUND_AUTO=5
# MAIL_SYNC_MAX_ROUNDS_AUTO=3
# MAIL_SYNC_TIME_BUDGET_MS_AUTO=55000
# 12h SLA 补扫（run-sla-mailbox-sync cron）
# MAIL_SLA_SYNC_HOURS=12
# MAIL_SYNC_SLA_PER_ROUND=15
# MAIL_SYNC_SLA_MAX_ROUNDS=3
# MAIL_SYNC_SLA_TIME_BUDGET_MS=52000
# MAIL_SYNC_SLA_WIDEN_MINUTES=15
# IMAP SINCE/BEFORE 日历扩窗（小时），再用 Date 头筛真 12h 窗
# MAIL_SYNC_SLA_IMAP_WIDEN_HOURS=24
# last_uid 以下 UID 区间回补（防增量漏扫中间 UID）
# MAIL_SYNC_SLA_GAP_UID_LOOKBACK=500
# MAIL_SLA_MAILBOX_WALL_MS=90000
# 历史后台回补（run-mailbox-history-backfill cron，首次手动同步后 auto_continue）
# MAIL_SYNC_HISTORY_PER_ROUND=10
# MAIL_SYNC_HISTORY_MAX_ROUNDS=3
# MAIL_SYNC_HISTORY_TIME_BUDGET_MS=52000
# MAIL_HISTORY_BACKFILL_WALL_MS=120000
# MAIL_BODY_REPAIR_BATCH_LIMIT=3
# MAIL_FETCH_TASK_BATCH_LIMIT=2

# --- Edge Runtime 资源（自建 volumes/functions/main/index.ts；均有硬顶）---
# EDGE_CPU_TIME_SOFT_LIMIT_MS=20000
# EDGE_CPU_TIME_HARD_LIMIT_MS=45000
# EDGE_WORKER_TIMEOUT_MS=60000
# EDGE_MEMORY_LIMIT_MB=150
