# ============================================================
# Dify 环境变量配置
# 复制为 .env.dify 并填入真实值：
#   cp .env.dify.example .env.dify
# 注意：当前仓库 Dify 运行入口为 http://localhost:8090（见 dify/docker/docker-compose.cs.yml）
# ============================================================

# --- Dify 安全配置 ---
DIFY_SECRET_KEY=sk-dify-secret-key-change-me
DIFY_INIT_PASSWORD=Dify12345
DIFY_DB_USERNAME=postgres
DIFY_DB_PASSWORD=difyai123456
DIFY_DB_DATABASE=dify
DIFY_REDIS_PASSWORD=difyai123456

# --- ngrok 配置（需要 https://ngrok.com 账号） ---
# 获取方法：登录 ngrok Dashboard → Your Authtoken
NGROK_AUTH_TOKEN=your_ngrok_auth_token_here
# Dify API 的自定义域名（可选，需付费 ngrok 套餐）
# NGROK_DOMAIN=your-domain.ngrok-free.app

# --- Supabase Edge Function 环境变量（设置方式见下方说明）---
# 部署 Dify 工作流后，获取每个工作流的 API URL 和 Key：
# Dify Web → 工作流 → 发布 → API 访问 → API Key
#
# Supabase 控制台设置：
#   supabase functions secrets set \
#     DIFY_GATEWAY_API_KEY=your-strong-gateway-key \
#     DIFY_ANALYZE_URL=https://xxx.ngrok-free.app/v1/workflows/run \
#     DIFY_ANALYZE_KEY=app-xxxxx \
#     DIFY_DRAFT_URL=https://xxx.ngrok-free.app/v1/workflows/run \
#     DIFY_DRAFT_KEY=app-xxxxx
#
# 注意：ngrok 免费版域名通常会变化；重启后请同步更新 Supabase secrets。

# --- 客户自动回复开关（Supabase secrets，可选）---
# AUTO_REPLY_CUSTOMER_ENABLED=true   # 总开关；false 则所有给客户自动模板不发（默认 true）
# AUTO_REPLY_RISK_MISSING_ORDER_NO=false   # 取消/改地址缺单号模板（默认 false，需显式开启）
# COMPENSATING_ALERT_BATCH=40   # schedule-compensating-alerts 每批扫描上限
