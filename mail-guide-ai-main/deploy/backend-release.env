# mail-guide-ai backend release manifest.
# Jenkins / operations should update this file per release, then run:
#   bash mail-guide-ai-main/scripts/linux/selfhosted/apply-backend-release.sh \
#     /data/temp/mail-guide-ai-main /data/service/supabase-selfhost
#
# 已执行过的 migration 脚本会自动跳过，无需运维事先查库。

RELEASE_VERSION="v1.7.1"

MIGRATIONS=(
  "20260714120000_unschedule_auto_draft_cron.sql"
)

# 自建：覆盖 migrations 中 *.supabase.co 的 cron，改为 http://kong:8000
# 必须 true：同步 vault/cron 脚本，unschedule auto-draft，且禁止再注册该 job
RUN_APPLY_VAULT_AND_CRON="true"

# 本版无 Edge Functions 代码变更
APPLY_FUNCTIONS="false"
BACKUP_FUNCTIONS="false"
