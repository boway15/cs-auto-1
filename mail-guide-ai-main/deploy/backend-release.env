# mail-guide-ai backend release manifest.
# Jenkins / operations should update this file per release, then run:
#   bash mail-guide-ai-main/scripts/linux/selfhosted/apply-backend-release.sh \
#     /data/temp/mail-guide-ai-main /data/service/supabase-selfhost
#
# 已执行过的 migration 脚本会自动跳过，无需运维事先查库。
#
# v1.10.1：
# - 前端：工作台发送详情展示出站附件预览/下载；发送详情弹窗可滚动
# - 抽取 SendLogDetailAttachments 与发送日志页共用
# - 无新增 SQL；下列 migration 为跨版本累计（已执行则自动跳过）
# - Functions 仍同步，确保 send-reply 出站归档逻辑在现网（已同步则仅重建）
#
# v1.10.0（现网 v1.8.0 同批合并）：
# - v1.9.0：Gmail MIME 正文选段 / 签名脏数据 / 工作台发件人与往来切换（无新 SQL）
# - 出站附件：发送成功归档 sent/ + Storage RLS + 发送日志预览下载
#
# v1.9.0：
# - MIME 正文选段：Gmail 回复引用感知，优先 multipart/alternative，跳过 message/rfc822 嵌入原文
# - 纯手机签名不再视为完整正文；正文补拉可覆盖仅签名脏数据
# - 工作台发件人展示/列表身份字段隔离；往来记录详情切换修复
#
# v1.8.0：
# - emails.reply_to_email（IMAP Reply-To）+ sync-mailbox / 自动回复收件人优先 Reply-To
# - iPhone/multipart/related 内联图（cid）识别与补拉，修复工作台破图与误报「无附件」

RELEASE_VERSION="v1.10.1"

MIGRATIONS=(
  "20260804120000_outbound_attachments_sent_archive_rls.sql"
)

RUN_APPLY_VAULT_AND_CRON="false"

APPLY_FUNCTIONS="true"
BACKUP_FUNCTIONS="true"
