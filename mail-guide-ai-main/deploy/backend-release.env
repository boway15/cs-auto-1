# mail-guide-ai backend release manifest.
# Jenkins / operations should update this file per release, then run:
#   bash mail-guide-ai-main/scripts/linux/selfhosted/apply-backend-release.sh \
#     /data/temp/mail-guide-ai-main /data/service/supabase-selfhost
#
# 已执行过的 migration 脚本会自动跳过，无需运维事先查库。
#
# v1.7.3：附件补拉防 Edge 整封回退超时、假 resolved 复核、stale running 回收

RELEASE_VERSION="v1.7.3"

MIGRATIONS=()

# 本版无 vault/cron 变更
RUN_APPLY_VAULT_AND_CRON="false"

# 须同步 sync-mailbox / run-email-attachment-repair-tasks / _shared/*
APPLY_FUNCTIONS="true"
BACKUP_FUNCTIONS="true"
