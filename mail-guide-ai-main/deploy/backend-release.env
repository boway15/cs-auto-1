# mail-guide-ai backend release manifest.
# Jenkins / operations should update this file per release, then run:
#   bash mail-guide-ai-main/scripts/linux/selfhosted/apply-backend-release.sh \
#     /data/temp/mail-guide-ai-main /data/service/supabase-selfhost

RELEASE_VERSION="v1.2.0"

# List only the SQL files introduced by this release.
# Leave empty when no database migration is needed:
#   MIGRATIONS=()
MIGRATIONS=(
  "20260522140000_user_mailbox_grants_rls.sql"
  "20260522150000_mailbox_scope_closure.sql"
)

# Run when vault / pg_cron schedule or service-role cron wiring changes.
# The script is idempotent: it rewrites the service_role_key secret and
# recreates the expected cron jobs.
RUN_APPLY_VAULT_AND_CRON="false"

# Normal backend release updates Edge Functions every time.
APPLY_FUNCTIONS="true"

# Keep a local copy of current self-hosted function files before replacement.
BACKUP_FUNCTIONS="true"
