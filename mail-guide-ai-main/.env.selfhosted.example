# mail-guide-ai 连接自建 Supabase（Kong）
# 复制为 .env 或合并到现有 .env 后 npm run dev / docker compose build

VITE_SUPABASE_URL=http://localhost:8000
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=self-hosted

# --- ERP（仅 Edge Functions 使用；勿提交真实密码）---
# 实际配置在 supabase-selfhost/.env.functions（见 docs/self-hosted-supabase.md）
# ERP_TOKEN_URL=https://loginserver.bestwo.net:9443/connect/token
# ERP_OMS_BASE=https://omsapi.bestwo.net:9443
# ERP_GATEWAY_BASE=https://gatewayjava.bestwo.net:9443
# ERP_USERNAME=
# ERP_PASSWORD=
# ERP_CLIENT_ID=ERP
# 测试环境密码表单字段为 pw 时设为 pw，正式一般为 password
# ERP_TOKEN_PASSWORD_FIELD=password
